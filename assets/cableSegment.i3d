<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="cableSegment" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="make_cable_segment.py" version="1"/>
  </Asset>
  <Files/>
  <Materials>
    <Material name="iron" materialId="1" diffuseColor="0.30 0.31 0.33 1" specularColor="0.45 0.45 0.45"/>
  </Materials>
  <Shapes externalShapesFile="cableSegment.i3d.shapes">
  </Shapes>
  <Scene>
    <TransformGroup name="cable" nodeId="1">
      <Shape name="cableRoot" shapeId="1" kinematic="true" compound="true" collisionFilterGroup="0x2" collisionFilterMask="0x100000" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1" clipDistance="300" nodeId="2"/>
      <Shape name="cableChild" shapeId="1" compoundChild="true" collisionFilterGroup="0x2" collisionFilterMask="0x100000" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="1" clipDistance="300" nodeId="3"/>
    </TransformGroup>
  </Scene>

</i3D>
